<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DvaStream.App.ViewModels"
             xmlns:loc="using:DvaStream.App.Localization"
             x:Class="DvaStream.App.Views.DownloadView"
             x:DataType="vm:DownloadViewModel">

  <!-- Carte de téléchargement (M4-11) : progression, puis résultat -->
  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="{StaticResource RadiusLg}"
          Padding="16">
    <StackPanel Spacing="{StaticResource Space3}">

      <!-- En cours -->
      <StackPanel Spacing="{StaticResource Space3}" IsVisible="{Binding IsRunning}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="{Binding PhaseText}"
                     FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Grid.Column="1" Text="{Binding PercentText}"
                     FontSize="16" FontWeight="SemiBold"
                     IsVisible="{Binding !IsIndeterminate}"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
        <ProgressBar Minimum="0" Maximum="100" Height="8"
                     Value="{Binding Percent, Mode=OneWay}"
                     IsIndeterminate="{Binding IsIndeterminate}"
                     Foreground="{DynamicResource PrimaryBrush}"
                     Background="{DynamicResource SurfaceAltBrush}" />
        <TextBlock Text="{Binding StatsText}"
                   IsVisible="{Binding HasStats}"
                   FontSize="13"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <Button Classes="secondary"
                HorizontalAlignment="Left"
                Content="{loc:Loc Dl_Cancel}"
                Command="{Binding CancelCommand}"
                IsVisible="{Binding CanCancel}" />
      </StackPanel>

      <!-- Terminé -->
      <StackPanel Spacing="{StaticResource Space3}" IsVisible="{Binding IsDone}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Data="M5,12 L10,17 L19,7" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="2.2"
                StrokeLineCap="Round" StrokeJoin="Round" Width="20" Height="20" Stretch="Uniform"
                VerticalAlignment="Center" />
          <TextBlock Text="{Binding PhaseText}"
                     FontSize="16" FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding FileName}"
                     FontSize="14" FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextPrimaryBrush}" />
          <TextBlock Text="{Binding SavedToText}"
                     FontSize="13"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMutedBrush}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
          <Button Classes="primary"
                  Content="{loc:Loc Dl_OpenFile}"
                  Command="{Binding OpenFileCommand}"
                  IsVisible="{Binding CanOpenFile}" />
          <Button Classes="secondary"
                  Content="{loc:Loc Dl_Reveal}"
                  Command="{Binding RevealCommand}"
                  IsVisible="{Binding CanReveal}" />
        </StackPanel>
        <Button Classes="secondary"
                HorizontalAlignment="Left"
                Content="{loc:Loc Dl_Another}"
                Command="{Binding AnotherCommand}" />
      </StackPanel>

      <!-- Échec -->
      <StackPanel Spacing="{StaticResource Space3}" IsVisible="{Binding IsFailed}">
        <TextBlock Text="{Binding ErrorMessage}"
                   FontSize="16" FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}" />
        <TextBlock Text="{Binding ErrorAction}"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
          <Button Classes="primary"
                  Content="{loc:Loc Dl_Retry}"
                  Command="{Binding RetryCommand}" />
          <Button Classes="secondary"
                  Content="{loc:Loc Dl_Another}"
                  Command="{Binding AnotherCommand}" />
        </StackPanel>
      </StackPanel>

    </StackPanel>
  </Border>
</UserControl>
