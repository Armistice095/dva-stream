<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DvaStream.App.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DvaStream.App/Styles/Tokens.colors.axaml" />
        <ResourceInclude Source="avares://DvaStream.App/Styles/Tokens.layout.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://DvaStream.App/Styles/Controls.axaml" />

    <!-- Police de l'application : Plus Jakarta Sans (D-013), embarquée dans Assets/Fonts -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="avares://DvaStream.App/Assets/Fonts#Plus Jakarta Sans" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </Application.Styles>
</Application>
